<div class="w-full max-w-2xl">
  <h1 class="font-bold text-3xl mb-1"><%= @club.name %></h1>
  <p class="text-sm text-gray-500 mb-6">Club setup</p>

  <%= render "shared/club_setup_nav", club: @club %>

  <h2 class="text-lg font-semibold text-gray-900 mb-4">Courts</h2>

  <% if @courts.any? %>
    <table class="w-full text-sm mb-6">
      <thead>
        <tr class="border-b border-gray-200">
          <th class="text-left py-2 pr-4 font-medium text-gray-600">Name</th>
          <th class="text-left py-2 font-medium text-gray-600">Surface</th>
          <th class="py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @courts.each do |court| %>
          <tr>
            <td class="py-2 pr-4 font-medium text-gray-900">Court <%= court.name %></td>
            <td class="py-2 text-gray-600 capitalize"><%= court.surface %></td>
            <td class="py-2 text-right space-x-3">
              <%= link_to "Edit", edit_club_court_path(@club, court), class: "text-blue-600 hover:text-blue-500" %>
              <%= button_to "Remove", club_court_path(@club, court), method: :delete,
                  data: { turbo_confirm: "Remove court #{court.name}?" },
                  class: "text-red-500 hover:text-red-400 bg-transparent border-0 cursor-pointer text-sm p-0" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-400 text-sm mb-6">No courts yet.</p>
  <% end %>

  <div class="border-t border-gray-200 pt-5">
    <p class="text-sm font-medium text-gray-700 mb-3">Add court</p>
    <%= render "form", club: @club, court: @court %>
  </div>

  <%= render "shared/csv_import",
      import_url: import_club_courts_path(@club),
      columns: %w[name surface],
      example: "name,surface\n1,grass\n2,grass\n3,hard" %>
</div>
