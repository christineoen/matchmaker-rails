<div class="w-full max-w-3xl">
  <%= render "steps", club: @club, event: @event, current_step: 4 %>

  <%# Matches %>
  <section>
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-base font-semibold text-gray-900">Rounds</h2>
      <% next_round_number = (@rounds.map(&:number).max || 0) + 1 %>
      <%= button_to "Generate Round #{next_round_number}",
          club_event_rounds_path(@club, @event),
          method: :post,
          class: "text-sm bg-blue-600 text-white px-3 py-1.5 rounded hover:bg-blue-500" %>
    </div>

    <% if @rounds.any? %>
      <% latest_round_id = @rounds.map(&:id).max %>
      <% @rounds.sort_by { |r| -r.number }.each do |round| %>
        <% played_player_ids = round.match_players.map(&:player_id).to_set %>
        <% sitters = @event_players.reject { |ep| played_player_ids.include?(ep.player_id) } %>

        <details <%= round.id == latest_round_id ? "open" : "" %> class="mb-3 border border-gray-200 rounded-lg">
          <summary class="flex items-center justify-between px-4 py-3 cursor-pointer list-none select-none hover:bg-gray-50 rounded-lg">
            <span class="font-medium text-gray-800">Round <%= round.number %></span>
            <div class="flex items-center gap-2" onclick="event.stopPropagation()">
              <%= button_to "Regenerate",
                  club_event_rounds_path(@club, @event),
                  params: { round_number: round.number },
                  method: :post,
                  class: "text-xs text-gray-500 hover:text-gray-700 bg-white border border-gray-300 rounded px-2 py-1" %>
              <%= button_to "Delete",
                  club_event_round_path(@club, @event, round),
                  method: :delete,
                  data: { turbo_confirm: "Delete Round #{round.number}?" },
                  class: "text-xs text-red-400 hover:text-red-600 bg-white border border-red-200 rounded px-2 py-1" %>
            </div>
          </summary>

          <div class="px-4 pb-4 pt-2">
            <% round.matches.each do |match| %>
              <% team_a = match.match_players.select(&:team_a?).map(&:player) %>
              <% team_b = match.match_players.select(&:team_b?).map(&:player) %>
              <div class="mb-3 last:mb-0">
                <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Court <%= match.court.name %></p>
                <div class="grid grid-cols-2 gap-2">
                  <div class="bg-blue-50 rounded px-3 py-2">
                    <p class="text-xs font-medium text-blue-600 mb-1">Team A</p>
                    <% team_a.each do |p| %>
                      <div class="flex items-baseline justify-between gap-2 text-sm">
                        <span class="text-gray-900"><%= p.name %></span>
                        <span class="text-gray-400 text-xs whitespace-nowrap">
                          <%= p.male? ? "M" : "F" %> <%= p.grade_level&.name || "—" %>
                        </span>
                      </div>
                    <% end %>
                  </div>
                  <div class="bg-orange-50 rounded px-3 py-2">
                    <p class="text-xs font-medium text-orange-600 mb-1">Team B</p>
                    <% team_b.each do |p| %>
                      <div class="flex items-baseline justify-between gap-2 text-sm">
                        <span class="text-gray-900"><%= p.name %></span>
                        <span class="text-gray-400 text-xs whitespace-nowrap">
                          <%= p.male? ? "M" : "F" %> <%= p.grade_level&.name || "—" %>
                        </span>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>

            <% if sitters.any? %>
              <div class="mt-3 border border-gray-200 rounded px-3 py-2">
                <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Sitting out</p>
                <% sitters.each do |ep| %>
                  <div class="flex items-baseline justify-between gap-2 text-sm">
                    <span class="text-gray-500"><%= ep.player.name %></span>
                    <span class="text-gray-400 text-xs whitespace-nowrap">
                      <%= ep.player.male? ? "M" : "F" %> <%= ep.player.grade_level&.name || "—" %>
                    </span>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>
    <% else %>
      <p class="text-sm text-gray-400">No rounds yet. Click "Generate Round 1" to start.</p>
    <% end %>
  </section>
</div>
