<%# locals: club:, event:, current_step: %>
<% steps = [
  { label: "Game",    path: event&.persisted? ? edit_club_event_path(club, event) : nil },
  { label: "Courts",  path: event&.persisted? ? courts_club_event_path(club, event) : nil },
  { label: "Players", path: event&.persisted? ? players_setup_club_event_path(club, event) : nil },
  { label: "Matches", path: event&.persisted? ? club_event_path(club, event) : nil },
] %>

<div class="flex items-start mb-8">
  <% steps.each_with_index do |step, i| %>
    <% step_num = i + 1 %>
    <% active    = step_num == current_step %>
    <% visited   = step_num <= current_step %>

    <% if i > 0 %>
      <div class="flex-1 h-px bg-gray-200 mt-4 mx-2"></div>
    <% end %>

    <div class="flex flex-col items-center w-16">
      <% circle = visited ? "bg-blue-600 text-white" : "bg-gray-100 text-gray-400" %>
      <% ring   = active  ? "ring-2 ring-blue-200" : "" %>

      <% if !active && step[:path] %>
        <%= link_to step[:path], class: "w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold #{circle} #{ring} hover:bg-blue-500" do %>
          <%= step_num %>
        <% end %>
      <% else %>
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold <%= circle %> <%= ring %>">
          <%= step_num %>
        </div>
      <% end %>

      <span class="text-xs mt-1.5 text-center leading-tight <%= visited ? 'text-gray-900 font-medium' : 'text-gray-400' %>">
        <%= step[:label] %>
      </span>
    </div>
  <% end %>
</div>
