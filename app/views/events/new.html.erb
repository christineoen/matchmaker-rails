<div class="w-full max-w-xl pb-20">
  <%= render "steps", club: @club, event: nil, current_step: 1 %>

  <h2 class="text-lg font-semibold text-gray-900 mb-4">Game info</h2>

  <%= render "shared/errors", object: @event %>

  <%= form_with model: [ @club, @event ], id: "step-form" do |f| %>
    <div class="mb-4">
      <%= f.label :label, "Session name (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :label, placeholder: "e.g. Tuesday Night Doubles",
          class: "block w-full shadow-sm rounded-md border border-gray-300 focus:outline-blue-600 px-3 py-2 text-sm" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :gender_format, "Format", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :gender_format, Event.gender_formats.keys.map { |k| [ k.tr("_", " ").capitalize, k ] }, {},
            required: true,
            class: "block w-full shadow-sm rounded-md border border-gray-300 focus:outline-blue-600 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :started_at, "Date & time", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.datetime_local_field :started_at, required: true,
            class: "block w-full shadow-sm rounded-md border border-gray-300 focus:outline-blue-600 px-3 py-2 text-sm" %>
      </div>
    </div>
  <% end %>
</div>

<%= render "step_footer",
    back_path: club_events_path(@club),
    back_label: "Cancel",
    next_label: "Next: Courts →" %>
