<%# locals: back_path:, back_label: "← Back", next_label: "Next →" %>
<div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 z-10">
  <div class="container mx-auto px-5 py-3 flex items-center justify-between">
    <% if back_path %>
      <%= link_to back_label, back_path,
          class: "px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 border border-gray-300 rounded-md hover:bg-gray-50" %>
    <% else %>
      <div></div>
    <% end %>

    <button type="submit" form="step-form"
            class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium rounded-md cursor-pointer">
      <%= next_label %>
    </button>
  </div>
</div>
