<div class="w-full max-w-2xl">
  <h1 class="font-bold text-3xl mb-1"><%= @club.name %></h1>
  <p class="text-sm text-gray-500 mb-6">Club setup</p>

  <%= render "shared/club_setup_nav", club: @club %>

  <div class="grid grid-cols-3 gap-4 mb-8">
    <%= link_to club_grade_levels_path(@club), class: "block border border-gray-200 rounded-lg p-5 hover:border-blue-300 hover:bg-blue-50 transition-colors" do %>
      <p class="text-3xl font-bold text-gray-900"><%= @club.grade_levels.count %></p>
      <p class="text-sm font-medium text-gray-600 mt-1">Grade levels</p>
    <% end %>
    <%= link_to club_courts_path(@club), class: "block border border-gray-200 rounded-lg p-5 hover:border-blue-300 hover:bg-blue-50 transition-colors" do %>
      <p class="text-3xl font-bold text-gray-900"><%= @club.courts.count %></p>
      <p class="text-sm font-medium text-gray-600 mt-1">Courts</p>
    <% end %>
    <%= link_to club_players_path(@club), class: "block border border-gray-200 rounded-lg p-5 hover:border-blue-300 hover:bg-blue-50 transition-colors" do %>
      <p class="text-3xl font-bold text-gray-900"><%= @club.players.count %></p>
      <p class="text-sm font-medium text-gray-600 mt-1">Players</p>
    <% end %>
  </div>

  <div class="flex items-center justify-between mb-3">
    <h2 class="text-lg font-semibold text-gray-900">Events</h2>
    <%= link_to "New event", new_club_event_path(@club),
        class: "px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium rounded-md" %>
  </div>

  <% if @events.any? %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-200">
          <th class="text-left py-2 font-medium text-gray-600">Session</th>
          <th class="text-left py-2 font-medium text-gray-600">Format</th>
          <th class="text-left py-2 font-medium text-gray-600">Date</th>
          <th class="text-left py-2 font-medium text-gray-600">Players</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @events.each do |event| %>
          <tr>
            <td class="py-2 font-medium">
              <%= link_to event.label.presence || "Session", club_event_path(@club, event),
                  class: "text-blue-600 hover:text-blue-500" %>
            </td>
            <td class="py-2 text-gray-600 capitalize"><%= event.gender_format.tr("_", " ") %></td>
            <td class="py-2 text-gray-600"><%= event.started_at.strftime("%-d %b %Y, %H:%M") %></td>
            <td class="py-2 text-gray-600"><%= event.event_players.count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-sm text-gray-400">No events yet.</p>
  <% end %>
</div>
