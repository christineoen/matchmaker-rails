<%= render "shared/errors", object: grade_level %>

<%= form_with model: [ club, grade_level ] do |f| %>
  <div class="flex gap-3 items-end">
    <div>
      <%= f.label :rank, "Rank", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :rank, min: 1, required: true,
          class: "block w-20 shadow-sm rounded-md border border-gray-300 focus:outline-blue-600 px-3 py-2" %>
    </div>
    <div class="flex-1">
      <%= f.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, required: true, placeholder: "e.g. Grade 1, A, Beginner",
          class: "block w-full shadow-sm rounded-md border border-gray-300 focus:outline-blue-600 px-3 py-2" %>
    </div>
    <%= f.submit class: "px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium rounded-md cursor-pointer" %>
  </div>
<% end %>
