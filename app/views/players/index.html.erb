<div class="w-full max-w-2xl">
  <h1 class="font-bold text-3xl mb-1"><%= @club.name %></h1>
  <p class="text-sm text-gray-500 mb-6">Club setup</p>

  <%= render "shared/club_setup_nav", club: @club %>

  <h2 class="text-lg font-semibold text-gray-900 mb-4">Players</h2>

  <% if @players.any? %>
    <table class="w-full text-sm mb-6">
      <thead>
        <tr class="border-b border-gray-200">
          <th class="text-left py-2 font-medium text-gray-600">Name</th>
          <th class="text-left py-2 font-medium text-gray-600">Gender</th>
          <th class="text-left py-2 font-medium text-gray-600">Grade</th>
          <th class="text-left py-2 font-medium text-gray-600">±</th>
          <th class="text-left py-2 font-medium text-gray-600">Courts</th>
          <th class="py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @players.each do |player| %>
          <tr>
            <td class="py-2 font-medium text-gray-900"><%= player.name %></td>
            <td class="py-2 text-gray-600 capitalize"><%= player.gender %></td>
            <td class="py-2 text-gray-600"><%= player.grade_level&.name || "—" %></td>
            <td class="py-2 text-gray-600">
              <% if player.grade_offset > 0 %>
                <span class="text-green-600">+<%= player.grade_offset %></span>
              <% elsif player.grade_offset < 0 %>
                <span class="text-red-500"><%= player.grade_offset %></span>
              <% else %>
                <span class="text-gray-400">0</span>
              <% end %>
            </td>
            <td class="py-2 text-gray-500 text-xs">
              <%= player.avoids_hard_courts? ? "No hard" : "—" %>
            </td>
            <td class="py-2 text-right space-x-3">
              <%= link_to "Edit", edit_club_player_path(@club, player), class: "text-blue-600 hover:text-blue-500" %>
              <%= button_to "Remove", club_player_path(@club, player), method: :delete,
                  data: { turbo_confirm: "Remove #{player.name}?" },
                  class: "text-red-500 hover:text-red-400 bg-transparent border-0 cursor-pointer text-sm p-0" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-400 text-sm mb-6">No players yet.</p>
  <% end %>

  <div class="border-t border-gray-200 pt-5">
    <p class="text-sm font-medium text-gray-700 mb-3">Add player</p>
    <%= render "form", club: @club, player: @player %>
  </div>

  <%= render "shared/csv_import",
      import_url: import_club_players_path(@club),
      columns: %w[name gender],
      optional_columns: %w[grade grade_offset avoids_hard_courts],
      example: "name,gender,grade,avoids_hard_courts,grade_offset\nAlice Smith,female,Grade 1,false,0.1\nBob Jones,male,,,true" %>
</div>
