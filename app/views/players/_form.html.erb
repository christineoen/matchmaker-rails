<%= render "shared/errors", object: player %>

<%= form_with model: [ club, player ] do |f| %>
  <div class="mb-3">
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, required: true,
        class: "block w-full shadow-sm rounded-md border border-gray-300 focus:outline-blue-600 px-3 py-2 text-sm" %>
  </div>

  <div class="grid grid-cols-3 gap-3 mb-3">
    <div>
      <%= f.label :gender, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :gender, Player.genders.keys.map { |g| [g.capitalize, g] }, { prompt: "Select…" },
          required: true,
          class: "block w-full shadow-sm rounded-md border border-gray-300 focus:outline-blue-600 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :grade_level_id, "Grade level", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :grade_level_id, club.grade_levels.ordered.map { |g| [g.name, g.id] }, { prompt: "None" },
          class: "block w-full shadow-sm rounded-md border border-gray-300 focus:outline-blue-600 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :grade_offset, "Rank offset", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :grade_offset, min: -0.4, max: 0.4, step: 0.1,
          class: "block w-full shadow-sm rounded-md border border-gray-300 focus:outline-blue-600 px-3 py-2 text-sm" %>
    </div>
  </div>

  <div class="mb-3">
    <label class="flex items-center gap-2 cursor-pointer">
      <%= f.check_box :avoids_hard_courts, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
      <span class="text-sm text-gray-700">Avoids hard courts</span>
    </label>
  </div>

  <%= f.submit class: "px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium rounded-md cursor-pointer" %>
<% end %>
