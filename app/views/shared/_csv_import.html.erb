<details class="border-t border-gray-200 pt-5 mt-5">
  <summary class="text-sm font-medium text-gray-700 cursor-pointer hover:text-gray-900 list-none flex items-center gap-2">
    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
    </svg>
    Import from CSV
  </summary>

  <div class="mt-4 space-y-3">
    <div class="text-xs text-gray-500">
      Required columns:
      <% columns.each do |col| %>
        <code class="bg-gray-100 px-1 rounded"><%= col %></code>
      <% end %>
      <% if local_assigns[:optional_columns]&.any? %>
        — Optional:
        <% optional_columns.each do |col| %>
          <code class="bg-gray-100 px-1 rounded"><%= col %></code>
        <% end %>
      <% end %>
    </div>

    <% if local_assigns[:example] %>
      <pre class="text-xs bg-gray-50 border border-gray-200 rounded p-2 text-gray-700"><%= example %></pre>
    <% end %>

    <%= form_with url: import_url, multipart: true do |f| %>
      <div class="flex items-center gap-3">
        <%= f.file_field :file, accept: ".csv",
            class: "text-sm text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-sm file:font-medium file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 cursor-pointer" %>
        <%= f.submit "Import", class: "px-3 py-1.5 bg-gray-700 hover:bg-gray-600 text-white text-sm font-medium rounded-md cursor-pointer" %>
      </div>
    <% end %>
  </div>
</details>
